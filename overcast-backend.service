[Unit]
Description=Overcast LAN Cloud Storage Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/CloudStorage/backend
ExecStart=%h/CloudStorage/backend/env/bin/python %h/CloudStorage/backend/run.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
